{
  "name": "asistencia-ionic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "android:live": "npx cap run android --live-reload --host=0.0.0.0 --port=5173",
    "android:emulator": "npx cap run android --live-reload --host=10.0.2.2 --port=5173",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:live": "npx cap run ios --live-reload --host=0.0.0.0 --port=5173",
    "sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/preferences": "^8.0.0",
    "@ionic/vue": "^8.7.17",
    "@ionic/vue-router": "^8.7.17",
    "axios": "^1.13.4",
    "ionicons": "^8.0.13",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.24",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
